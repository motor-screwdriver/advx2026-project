# PixelLab is used only by the Python asset-generation tools.
PIXELLAB_SECRET=

# URL of the deployed Go backend (see README "Deploy"). The local client
# (web + Expo Go) talks to this server; there is no local backend any more.
EXPO_PUBLIC_API_ORIGIN=
# Backwards-compatible alias also supported by the app:
# EXPO_PUBLIC_API_URL=

# --- Server-side values below live on the server only ---
# They are written to /opt/8bit-sleep/server.env by the deploy pipeline from
# GitHub secrets/vars; do NOT put them in the client bundle (no EXPO_PUBLIC_*).
# AI_BASE_URL=http://127.0.0.1:8000/v1   # GitHub secret (vLLM via reverse tunnel)
# AI_API_KEY=                            # GitHub secret
# AI_MODEL=Qwen/Qwen2.5-7B-Instruct
# AI_MAX_TOKENS=1200
